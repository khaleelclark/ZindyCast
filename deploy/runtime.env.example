# Both user units load the SAME private file: ~/.config/zindycast/runtime.env.
# Core weather providers need no API keys. Optional push setup is described below.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=4311
SERVE_WEB=1
# Paths resolve relative to each unit's WorkingDirectory, which must match.
# For another data directory use explicit absolute paths; no ~ or $HOME expansion.
ZINDYCAST_DB_PATH=var/coordination.sqlite
ZINDYCAST_JOBS_PATH=var/jobs.sqlite
ZINDYCAST_INSTALLATIONS_PATH=var/installations.sqlite
ZINDYCAST_NOTIFICATIONS_PATH=var/notifications.sqlite
ZINDYCAST_VERIFICATION_PATH=var/verification.sqlite

# Optional private tracker at /wet-bulb-tracker; API and worker must match.
# Include this database in backup sets when enabled or when retained data exists.
ZINDYCAST_WET_BULB_TRACKER=0
ZINDYCAST_WET_BULB_TRACKER_PATH=var/wet-bulb-tracker.sqlite
ZINDYCAST_WET_BULB_NAME=Example place
ZINDYCAST_WET_BULB_LATITUDE=0
ZINDYCAST_WET_BULB_LONGITUDE=0
ZINDYCAST_WET_BULB_TIMEZONE=UTC
ZINDYCAST_WET_BULB_COUNTRY=US

# Set the exact browser-facing HTTPS origin (including a non-default port),
# without a trailing slash, before serving through your private HTTPS proxy.
# ZINDYCAST_PUBLIC_ORIGIN=https://weather.example.com

# Optional push: after setting the origin above, run configure-notifications.mjs
# against your private copy. It generates these values locally; never commit keys.
# ZINDYCAST_VAPID_PUBLIC_KEY=...
# ZINDYCAST_VAPID_PRIVATE_KEY=...
# ZINDYCAST_VAPID_SUBJECT=https://weather.example.com
