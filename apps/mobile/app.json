{
  "expo": {
    "name": "ZindyCast",
    "slug": "zindycast",
    "version": "0.1.3",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "android": {
      "package": "family.zindycast.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-foreground.png",
        "monochromeImage": "./assets/logo-monochrome.png",
        "backgroundColor": "#234e47"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "backgroundColor": "#0a1728",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "platforms": [
      "android"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#234e47",
          "image": "./assets/logo-foreground.png",
          "imageWidth": 240
        }
      ],
      "./plugins/with-release-signing.cjs"
    ]
  }
}
