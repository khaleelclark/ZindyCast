<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/widget_logo" android:contentDescription="ZindyCast" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ZindyCast" android:textSize="13sp" android:textStyle="bold" android:textColor="#234e47" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your weather" android:textSize="10sp" android:textColor="#526d67" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textSize="26sp" android:textColor="#234e47" android:contentDescription="Refresh widget weather" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:scaleType="fitCenter" android:contentDescription="Weather readings" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open app · choose a city" android:textSize="10sp" android:textColor="#526d67" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Weather beyond temperature" android:textSize="9sp" android:textColor="#526d67" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
