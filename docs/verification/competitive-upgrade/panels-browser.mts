 if(u.pathname.startsWith('/api/v1/verification/scorecards/')){const p=repo.listPlaces('11111111-1111-4111-8111-111111111111')[0];return route.fulfill({json:{status:'success',scorecard:repo.scorecard(p.targetKey)}});}
