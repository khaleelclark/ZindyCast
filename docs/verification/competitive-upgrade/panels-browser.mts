 await page.getByRole('button',{name:'Choose a reference station'}).click();await page.getByLabel('Reference station').selectOption('KTUL');await page.getByRole('button',{name:'Start measuring accuracy'}).click();await page.getByRole('button',{name:'Stop measuring this place'}).waitFor();await page.getByRole('table',{name:'Average forecast error'}).waitFor();await page.getByRole('button',{name:'Stop measuring this place'}).click();await page.getByRole('button',{name:'Choose a reference station'}).waitFor();
 assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),true);assert.deepEqual(errors,[]);assert.equal(outside,0);assert.equal(posts,4);await page.screenshot({path:`/tmp/competitive-panels-${width}.png`,fullPage:true});reports.push({width,posts,outside,errors,passed:true});await context.close();repo.close();}}
