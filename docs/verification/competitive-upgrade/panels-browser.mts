const time=new Date(now-60000).toISOString();const observation={sourceId:'https://api.weather.gov/stations/KTUL/observations/'+encodeURIComponent(time),time,textDescription:'Fixture',measurements:Object.fromEntries(observationFields.map(([,local])=>[local,{value:local==='temperatureC'?0:local==='dewPointC'?-5:2,qualityControl:'V',qualityMeaning:'verified_pass_levels_1_2_3'}])),missingFields:[]};
