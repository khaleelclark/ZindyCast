{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "object",
      "properties": {
        "stationId": {
          "type": "string",
          "pattern": "^US[A-Z0-9]{9}$"
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "stationId",
        "startDate",
        "endDate"
      ],
      "additionalProperties": false
    },
    "station": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "null"
        },
        "coordinates": {
          "type": "null"
        },
        "elevationM": {
          "type": "null"
        },
        "metadataStatus": {
          "type": "string",
          "const": "not_retrieved"
        }
      },
      "required": [
        "id",
        "name",
        "coordinates",
        "elevationM",
        "metadataStatus"
      ],
      "additionalProperties": false
    },
    "timeContext": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "const": "source daily calendar labels"
        },
        "timezone": {
          "type": "null"
        },
        "observationTime": {
          "type": "null"
        },
        "intervalStart": {
          "type": "null"
        },
        "intervalEnd": {
          "type": "null"
        }
      },
      "required": [
        "basis",
        "timezone",
        "observationTime",
        "intervalStart",
        "intervalEnd"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "properties": {
        "TMAX": {
          "type": "string",
          "const": "°C"
        },
        "TMIN": {
          "type": "string",
          "const": "°C"
        },
        "PRCP": {
          "type": "string",
          "const": "mm"
        }
      },
      "required": [
        "TMAX",
        "TMIN",
        "PRCP"
      ],
      "additionalProperties": false
    },
    "rawUnits": {
      "type": "object",
      "properties": {
        "TMAX": {
          "type": "string",
          "const": "tenths °C"
        },
        "TMIN": {
          "type": "string",
          "const": "tenths °C"
        },
        "PRCP": {
          "type": "string",
          "const": "tenths mm"
        }
      },
      "required": [
        "TMAX",
        "TMIN",
        "PRCP"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "NOAA NCEI"
        },
        "dataset": {
          "type": "string",
          "const": "GHCN-Daily"
        },
        "datasetVersion": {
          "type": "null"
        },
        "classification": {
          "type": "string",
          "const": "station_daily_summary"
        },
        "requestUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "const": "https://www.ncei.noaa.gov/pub/data/ghcn/daily/readme.txt"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "sourceIssuedAt": {
          "type": "null"
        },
        "sourceUpdatedAt": {
          "type": "null"
        },
        "adapterVersion": {
          "type": "string",
          "const": "ghcnd-daily-v1"
        }
      },
      "required": [
        "provider",
        "dataset",
        "datasetVersion",
        "classification",
        "requestUrl",
        "sourceUrl",
        "retrievedAt",
        "sourceIssuedAt",
        "sourceUpdatedAt",
        "adapterVersion"
      ],
      "additionalProperties": false
    },
