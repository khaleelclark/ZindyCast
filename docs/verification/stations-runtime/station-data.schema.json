      "minItems": 1,
      "maxItems": 366,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "TMAX": {
            "type": "object",
            "properties": {
              "rawValue": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9999,
                    "maximum": 99999
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "measurementFlag": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[ A-Za-z0-9]$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qualityFlag": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[ A-Za-z0-9]$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceFlag": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[ A-Za-z0-9]$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "missingReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "absent_month",
                      "source_missing"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qcStatus": {
                "type": "string",
                "enum": [
                  "missing",
                  "unflagged",
                  "flagged",
                  "unknown_code"
                ]
              },
              "trace": {
                "type": "boolean"
              },
              "presumedZero": {
                "type": "boolean"
              },
              "unknownFlags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "measurement",
                    "quality",
                    "source"
                  ]
                }
              }
            },
            "required": [
              "rawValue",
              "value",
              "measurementFlag",
              "qualityFlag",
              "sourceFlag",
              "missingReason",
              "qcStatus",
              "trace",
              "presumedZero",
              "unknownFlags"
