# Copy to .env. npm start, dev:api and start:worker load this file.
# Existing process environment takes precedence. Never commit your .env.
API_HOST=127.0.0.1
API_PORT=4311
# Set to your exact external HTTPS origin, including a nonstandard port if used.
# No trailing slash. Localhost ports 4310/4311 are allowed automatically.
# ZINDYCAST_PUBLIC_ORIGIN=https://weather.example.com

# API and worker MUST use the same database paths. Relative to repository root.
ZINDYCAST_DB_PATH=var/coordination.sqlite
ZINDYCAST_JOBS_PATH=var/jobs.sqlite
ZINDYCAST_INSTALLATIONS_PATH=var/installations.sqlite
ZINDYCAST_NOTIFICATIONS_PATH=var/notifications.sqlite
ZINDYCAST_VERIFICATION_PATH=var/verification.sqlite

# Optional private wet-bulb log at /wet-bulb-tracker. Collection starts when
# both API and worker use the same settings. Choose your own location values.
ZINDYCAST_WET_BULB_TRACKER=0
ZINDYCAST_WET_BULB_TRACKER_PATH=var/wet-bulb-tracker.sqlite
ZINDYCAST_WET_BULB_NAME=Example place
ZINDYCAST_WET_BULB_LATITUDE=0
ZINDYCAST_WET_BULB_LONGITUDE=0
ZINDYCAST_WET_BULB_TIMEZONE=UTC
ZINDYCAST_WET_BULB_COUNTRY=US

# Optional Web Push: leave ALL three empty to disable push delivery.
# Generate your own matching keys; see deploy/configure-notifications.mjs.
ZINDYCAST_VAPID_PUBLIC_KEY=
ZINDYCAST_VAPID_PRIVATE_KEY=
ZINDYCAST_VAPID_SUBJECT=
# Optional browser-visible Mapbox configuration belongs in apps/web/.env.local,
# using apps/web/.env.example. Server secrets must never use PUBLIC_ prefixes.

# Docker Compose only: the browser-facing host port stays loopback-only by
# default. Set the bind address deliberately if a trusted reverse proxy runs
# outside this host. PUBLIC_MAPBOX_ACCESS_TOKEN is embedded at image build time.
ZINDYCAST_BIND_ADDRESS=127.0.0.1
ZINDYCAST_PORT=4311
PUBLIC_MAPBOX_ACCESS_TOKEN=
